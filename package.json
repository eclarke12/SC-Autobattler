{
  "name": "shipbattler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Star Citizen ship autobattler MVP — picks two real wiki ships, simulates a seeded round-based battle.",
  "scripts": {
    "probe": "node scripts/probe.mjs",
    "audit:bombs": "node scripts/audit-bomb-racks.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:weapon-damage": "node scripts/build-weapon-damage.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
